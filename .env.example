# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/email-assistant?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/outlook/oauth/callback

# ── AI ────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
